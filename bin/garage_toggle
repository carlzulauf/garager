#!/usr/bin/env bash

# Toggles the garage door by pulsing the relay attached to a GPIO line.
#
# Requires libgpiod v2 (`gpioset`). The line defaults to GPIO17 (physical pin 11)
# and can be changed with GARAGER_GPIO_LINE.
#
# The relay is active-low: pull the line low for half a second to short the
# garage door opener's terminals, then drive it high again and release it.

set -euo pipefail

exec gpioset --consumer garager --toggle 500ms,0 "${GARAGER_GPIO_LINE:-GPIO17}=0"
